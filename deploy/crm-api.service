[Unit]
Description=crm-api (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/project/server/crm
EnvironmentFile=/project/server/crm/crm.env
ExecStart=/usr/bin/java -Xms512m -Xmx1024m -jar /project/server/crm/crm-api.jar
SuccessExitStatus=143
Restart=always
RestartSec=5
StandardOutput=append:/var/log/crm-api.log
StandardError=append:/var/log/crm-api.log

[Install]
WantedBy=multi-user.target
