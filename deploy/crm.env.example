# ============================================================
# crm-api 生产环境变量模板
# 使用方式: 复制为 /opt/crm/crm.env 并填入真实值
# 注意: systemd EnvironmentFile 不支持单引号，直接写 KEY=VALUE
# JWT 密钥生成: openssl rand -hex 32
# ============================================================

# 数据库连接（云 TiDB 或 MySQL，服务器无需装数据库，保证网络可达即可）
CRM_DB_URL=jdbc:mysql://<DB_HOST>:4000/jdys-crm?sslMode=REQUIRED&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
CRM_DB_USER=<DB_USER>
CRM_DB_PASSWORD=<DB_PASSWORD>

# JWT 签名密钥（至少 32 字节，生产必须替换）
CRM_JWT_SECRET=<JWT_SECRET>

# 运行环境，固定 prod
SPRING_PROFILES_ACTIVE=prod

# 可选：覆盖默认端口（默认 8090）
# SERVER_PORT=8090

# 可选：前端跨域 Origin，逗号分隔
# CRM_CORS_ORIGINS=https://your-frontend-domain.com
